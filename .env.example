# Copy to .env and fill in what you have. Everything is optional: with no keys
# the app and CLI run in demo mode. `python -m overfit_court.preflight` checks
# whatever you set.

# --- Nebius Token Factory (models) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model ids can differ between accounts; preflight lists the Nemotron ids you can use.
MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
# USD per million tokens, only used to report spend. Check your Token Factory console.
# PRICE_NANO_IN=0.06
# PRICE_NANO_OUT=0.24
# PRICE_SUPER_IN=0.30
# PRICE_SUPER_OUT=0.90
# PRICE_ULTRA_IN=1.00
# PRICE_ULTRA_OUT=3.00

# --- Nebius Token Factory Sandboxes (backtests) ---
# A project with sandbox access enabled. Uses NEBIUS_API_KEY.
NEBIUS_PROJECT_ID=
# Where backtests run. With NEBIUS_API_KEY set the default is "nebius" (Token
# Factory Sandboxes), because model-written code then runs. "local" runs it in
# subprocesses on this machine: only for development.
# OC_EXECUTOR=nebius
# Optional: the UUID of an image that already has numpy and pandas, to skip the
# one-off setup (needed if your sandboxes have no outbound network).
# OC_SANDBOX_IMAGE=
# Where the UUID of the image built on first use is cached (rebuilt automatically
# when your numpy or pandas version changes).
# OC_SANDBOX_CACHE=.overfit_court_sandbox_image

# --- Tavily (prior-art search) ---
TAVILY_API_KEY=

# --- The court ---
# Largest parameter grid tried in one trial, and trading cost per unit of turnover.
OC_MAX_CONFIGS=120
OC_COST_BPS=5
# Where the command line keeps the court record (the app keeps one per visitor).
# OC_LEDGER_DIR=~/.overfit_court
