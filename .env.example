# Nebius Token Factory (OpenAI-compatible). Leave blank to run in demo/mock mode.
NEBIUS_API_KEY=
# Check the Token Factory quickstart for the current base URL.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Check exact model IDs with python -m overfit_court.preflight
MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b

TAVILY_API_KEY=

# Token Factory Sandboxes: your project must have sandbox access enabled.
NEBIUS_PROJECT_ID=
# Optional: an image UUID that already has numpy + pandas (skips one-off setup)
OC_SANDBOX_IMAGE=

# local | nebius  (nebius = Token Factory Sandboxes)
OC_EXECUTOR=local
OC_MAX_CONFIGS=120
OC_COST_BPS=5
